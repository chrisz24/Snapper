# SwiftPM build products — regenerated by `swift build`
.build/
# Assembled .app bundle — regenerated by `make app`
dist/
.DS_Store
*.xcuserstate

# Release artefacts, in case they are ever built outside dist/
*.dmg
*.zip
*.certSigningRequest

# Claude Code's local tool permissions — machine-specific, and it records local paths
.claude/settings.local.json

# Superseded copy of the signing script, kept locally only
*.bak

# App Store Connect API keys — the whole credential in plain text
*.p8

# Intermediate for the icon — regenerated by `make icon`
Resources/AppIcon.iconset/
